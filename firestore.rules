rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // PROFILES
    // Only the authenticated user can read/write their own profile
    match /profiles/{userId} {
      allow read: if isOwner(userId) || isAuthenticated(); // Allow reading other profiles for facility/professional matching
      allow write: if isOwner(userId);
    }

    // SHIFTS
    // Facilities can create and manage their own shifts.
    // Professionals can read all open shifts.
    match /shifts/{shiftId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.facility_id == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.facility_id == request.auth.uid;
    }

    // APPLICATIONS
    // Professionals can read/write their own applications.
    // Facilities can read/update applications attached to their shifts.
    match /applications/{applicationId} {
      allow read: if isAuthenticated(); // Simplified for prototype: typically restrict to owner or facility owner
      allow create: if isAuthenticated() && request.resource.data.professional_id == request.auth.uid;
      allow update: if isAuthenticated(); // Allow facilities to update status
      allow delete: if isAuthenticated() && resource.data.professional_id == request.auth.uid;
    }

    // CREDENTIALS
    // Only the professional can manage their own credentials
    match /credentials/{credentialId} {
      allow read, write: if isAuthenticated() && (request.resource.data.professional_id == request.auth.uid || resource.data.professional_id == request.auth.uid);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
